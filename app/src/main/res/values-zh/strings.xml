    <!-- About dialog -->
    <string name="about_subtitle">游戏性能监控</string>
    <string name="about_desc">FPS Meter 是一款专为 Android 打造的轻量级、免 root 的游戏性能悬浮窗与会话记录工具。</string>
    <string name="about_core_capabilities">核心功能</string>
    <string name="about_feature1_title">实时帧率与帧时间</string>
    <string name="about_feature1_desc">精准的帧率（FPS）与帧渲染时间（ms），支持自定义 HUD 样式。</string>
    <string name="about_feature2_title">双重测量引擎</string>
    <string name="about_feature2_desc">标准 Android Choreographer 与通过 Shizuku 的特权 SurfaceFlinger 监控。</string>
    <string name="about_feature3_title">图形 API 检测</string>
    <string name="about_feature3_desc">实时识别当前运行的 Vulkan 与 OpenGL ES 渲染管线。</string>
    <string name="about_feature4_title">全面温度指标</string>
    <string name="about_feature4_desc">实时读取 SoC 热点、CPU、GPU 与电池温度。</string>
    <string name="about_feature5_title">电量指示</string>
    <string name="about_feature5_desc">全屏游戏时在悬浮窗上实时显示剩余电量百分比。</string>
    <string name="about_feature6_title">游戏性能记录</string>
    <string name="about_feature6_desc">按游戏自动记录会话，保留平均、峰值与最低帧率历史日志。</string>
    <string name="about_feature7_title">开源且注重隐私</string>
    <string name="about_feature7_desc">免费开源。无广告、无遥测、无网络跟踪。</string>

