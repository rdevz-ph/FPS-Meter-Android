    <!-- About dialog -->
    <string name="about_subtitle">Gaming Performance Monitor</string>
    <string name="about_desc">FPS Meter is a lightweight, rootless gaming performance overlay and session recording tool designed for Android.</string>
    <string name="about_core_capabilities">Core Capabilities</string>
    <string name="about_feature1_title">Real-Time FPS &amp; Frame Time</string>
    <string name="about_feature1_desc">Accurate framerate (FPS) and frame render times (ms) with configurable HUD styles.</string>
    <string name="about_feature2_title">Dual Measurement Engines</string>
    <string name="about_feature2_desc">Standard Android Choreographer and privileged SurfaceFlinger monitoring via Shizuku.</string>
    <string name="about_feature3_title">Graphics API Detection</string>
    <string name="about_feature3_desc">Live identification of active Vulkan and OpenGL ES rendering pipelines.</string>
    <string name="about_feature4_title">Comprehensive Thermal Metrics</string>
    <string name="about_feature4_desc">Real-time temperature readouts for SoC hotspot, CPU, GPU, and Battery.</string>
    <string name="about_feature5_title">Battery Level Indicator</string>
    <string name="about_feature5_desc">Live remaining battery percentage directly on the overlay during fullscreen gaming.</string>
    <string name="about_feature6_title">Game Performance Logging</string>
    <string name="about_feature6_desc">Automatic session recording per game with average, peak, and minimum FPS history logs.</string>
    <string name="about_feature7_title">Open Source &amp; Privacy First</string>
    <string name="about_feature7_desc">Free and open source. No advertisements, no telemetry, and no network tracking.</string>

